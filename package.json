{
	"name": "min-bounding-rectangle",
	"version": "1.2.5",
	"main": "dist/min-bounding-rectangle.umd.js",
	"module": "dist/min-bounding-rectangle.es.mjs",
	"types": "dist/min-bounding-rectangle.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/min-bounding-rectangle.d.ts",
			"import": "./dist/min-bounding-rectangle.es.mjs",
			"require": "./dist/min-bounding-rectangle.umd.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:size": "npm run build && size-limit",
		"publisher": "vitest run && npm run build && npm publish",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mahetoodang/min-bounding-rectangle.git"
	},
	"author": "Herman Aadamsoo",
	"license": "MIT",
	"keywords": [
		"bounding box",
		"bounding rectangle",
		"min bounding rectangle",
		"minimum bounding rectangle",
		"minimal bounding rectangle",
		"bbox",
		"mbr",
		"geometry",
		"spatial",
		"geospatial",
		"gis",
		"computational geometry",
		"collision detection",
		"shape analysis",
		"2d",
		"polygon",
		"envelope",
		"extent"
	],
	"bugs": {
		"url": "https://github.com/mahetoodang/min-bounding-rectangle/issues"
	},
	"homepage": "https://github.com/mahetoodang/min-bounding-rectangle#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"concaveman": "^2.0.0",
		"mathjs": "^15.2.0"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^12.1.0",
		"@types/concaveman": "^1.1.6",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.10",
		"prettier": "^3.9.5",
		"rollup-plugin-visualizer": "^7.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"vite": "^8.0.5",
		"vite-plugin-compression2": "^2.5.3",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10"
	},
	"size-limit": [
		{
			"name": "ESM Bundle",
			"path": "dist/min-bounding-rectangle.es.mjs",
			"limit": "60 KB",
			"gzip": true
		},
		{
			"name": "UMD Bundle",
			"path": "dist/min-bounding-rectangle.umd.js",
			"limit": "60 KB",
			"gzip": true
		}
	]
}
